# -----------------------------------------------------------------------------
# ARIZONA RP — BRAINBURG (Server #5) — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets to Git.
# -----------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign session tokens and OAuth state/CSRF cookies.
# Generate with: openssl rand -base64 48   (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
AUTH_SECRET=

# Database (Supabase Postgres or any PostgreSQL 15+)
# Pooled connection string (Transaction mode, used by the app):
DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
# Direct connection string (Session mode — used by migrations):
DIRECT_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require

# Discord OAuth 2.0  (https://discord.com/developers/applications)
# Redirect URI must be exactly: {NEXT_PUBLIC_APP_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# VK OAuth 2.0 / VK ID (https://id.vk.com/)
# Redirect URI must be exactly: {NEXT_PUBLIC_APP_URL}/api/auth/vk/callback
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:3000/api/auth/vk/callback

# Future game server / bot integration (currently DISABLED — architecture ready)
# Leave empty to keep the integration layer in "Not connected" state.
FUTURE_GAME_API_URL=
FUTURE_GAME_API_KEY=

# Optional: restrict who may sign in (comma-separated Discord/VK IDs). Empty = everyone may sign in.
# ALLOWLIST_DISCORD_IDS=
# ALLOWLIST_VK_IDS=

# Rate limiting: use a shared store on serverless (e.g. Upstash Redis). Empty = in-memory limiter.
# RATE_LIMIT_REDIS_URL=
